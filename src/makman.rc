    HELPSUBITEM IDM_SOUND_OFF,         PANEL_OPTMENU
    HELPSUBITEM IDM_SUBMENU_PRI,       PANEL_OPTMENU
    HELPSUBITEM IDM_PRI_NORMAL,        PANEL_OPTMENU
    HELPSUBITEM IDM_PRI_CRIT,          PANEL_OPTMENU
    HELPSUBITEM IDM_PRI_SERVER,        PANEL_OPTMENU
    HELPSUBITEM IDM_SUBMENU_LANG,      PANEL_OPTMENU
    HELPSUBITEM IDM_LANG_EN,           PANEL_OPTMENU
    HELPSUBITEM IDM_LANG_ES,           PANEL_OPTMENU
    HELPSUBITEM IDM_LANG_NL,           PANEL_OPTMENU
    HELPSUBITEM IDM_LANG_DE,           PANEL_OPTMENU
    HELPSUBITEM IDM_LANG_FR,           PANEL_OPTMENU
    HELPSUBITEM IDM_LANG_IT,           PANEL_OPTMENU
    HELPSUBITEM IDM_BACKGRND,          PANEL_OPTMENU
    HELPSUBITEM IDM_FRAME,             PANEL_OPTMENU
    HELPSUBITEM IDM_SAVEONEXIT,        PANEL_OPTMENU
    HELPSUBITEM IDM_SUBMENU_HELP,      PANEL_HELPMENU
    HELPSUBITEM IDM_HELPINDEX,         PANEL_HELPMENU
    HELPSUBITEM IDM_HELPEXTENDED,      PANEL_HELPMENU
    HELPSUBITEM IDM_HELPHELPFORHELP,   PANEL_HELPMENU
    HELPSUBITEM IDM_HELPABOUT,         PANEL_COPYRIGHT
END

HELPSUBTABLE SUBTABLE_ABOUT

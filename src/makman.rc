    HELPSUBITEM IDM_JOY_B,             PANEL_CONTROLS
    HELPSUBITEM IDM_SUBMENU_CAL,       PANEL_CONTROLS
    HELPSUBITEM IDM_CAL_A,             PANEL_CONTROLS
    HELPSUBITEM IDM_CAL_B,             PANEL_CONTROLS

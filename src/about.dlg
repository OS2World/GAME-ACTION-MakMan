
DLGTEMPLATE IDD_ABOUTBOX
BEGIN
    /* The tagline, version, copyright, port and license lines are drawn with Unicode
       text by Uni_PaintAbout() (unitext.cpp). */
    DIALOG "About MakMan/2", IDD_ABOUTBOX, 44, 29, 276, 120, FS_NOBYTEALIGN |
WS_VISIBLE, FCF_SYSMENU | FCF_TITLEBAR
    BEGIN
        CONTROL "MakMan/2", 101, 15, 96, 240, 17, WC_STATIC, SS_TEXT | DT_LEFT | DT_TOP | DT_MNEMONIC | WS_VISIBLE | WS_GROUP
        PRESPARAMS PP_FONTNAMESIZE "24.Helvetica"
        PRESPARAMS PP_FOREGROUNDCOLOR , 0xff0000L
        DEFPUSHBUTTON "~OK", DID_OK, 111, 8, 45, 15
    END
END

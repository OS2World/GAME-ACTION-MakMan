DLGTEMPLATE IDD_HIGHSCORE LOADONCALL MOVEABLE DISCARDABLE
BEGIN
    /* The congratulation texts, the label and the two button captions are drawn with
       Unicode text from the language file (Uni_PaintHighscoreDlg / Uni_DrawButton in
       unitext.cpp); the title bar text is set at WM_INITDLG. */
    DIALOG  "Hall of Shame entry!", 100, 41, 68, 250, 110, WS_VISIBLE,
            FCF_SYSMENU | FCF_TITLEBAR
    BEGIN
        ENTRYFIELD      "", DID_HIGHNAME, 84, 32, 157, 8, ES_MARGIN
        CONTROL         "", DID_CANCEL, 20, 5, 100, 14, WC_BUTTON,
                        BS_USERBUTTON | WS_TABSTOP | WS_VISIBLE
        CONTROL         "", DID_OK, 128, 5, 100, 14, WC_BUTTON,
                        BS_USERBUTTON | BS_DEFAULT | WS_TABSTOP | WS_VISIBLE
    END
END

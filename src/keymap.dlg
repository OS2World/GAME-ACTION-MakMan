/* Key Mapping dialog.  The texts are not in the resources: labels are "MMUniText"
   controls and the buttons are owner drawn, both filled with Unicode text from the
   language file at run time (see keymap.cpp / unitext.cpp). */
DLGTEMPLATE DLG_KEYMAPPING MOVEABLE DISCARDABLE
BEGIN
    DIALOG "Key Mapping", DLG_KEYMAPPING, 30, 30, 242, 206,
        FS_NOBYTEALIGN|FS_DLGBORDER|WS_VISIBLE|WS_SAVEBITS,
        FCF_TITLEBAR
    BEGIN
        CONTROL "", DID_OK,     50, 4, 60, 14, WC_BUTTON, BS_USERBUTTON | BS_DEFAULT | WS_TABSTOP | WS_GROUP | WS_VISIBLE
        CONTROL "", DID_CANCEL, 132, 4, 60, 14, WC_BUTTON, BS_USERBUTTON | WS_TABSTOP | WS_VISIBLE
    END
END

DLGTEMPLATE DLG_KM_KEYBOARD MOVEABLE DISCARDABLE
BEGIN
    DIALOG "", DLG_KM_KEYBOARD, 0, 0, 200, 150, WS_VISIBLE
    BEGIN
        CONTROL "", IDC_KM_KH1, 4, 117, 192, 10, "MMUniText", WS_VISIBLE
        CONTROL "", IDC_KM_KH2, 4, 105, 192, 10, "MMUniText", WS_VISIBLE
        CONTROL "", IDC_KM_KL1+0, 8, 83, 88, 10, "MMUniText", WS_VISIBLE
        ENTRYFIELD "", IDC_KM_KBD1+0, 100, 81, 92, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP | WS_GROUP
        CONTROL "", IDC_KM_KL1+1, 8, 65, 88, 10, "MMUniText", WS_VISIBLE
        ENTRYFIELD "", IDC_KM_KBD1+1, 100, 63, 92, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        CONTROL "", IDC_KM_KL1+2, 8, 47, 88, 10, "MMUniText", WS_VISIBLE
        ENTRYFIELD "", IDC_KM_KBD1+2, 100, 45, 92, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        CONTROL "", IDC_KM_KL1+3, 8, 29, 88, 10, "MMUniText", WS_VISIBLE
        ENTRYFIELD "", IDC_KM_KBD1+3, 100, 27, 92, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
    END
END

DLGTEMPLATE DLG_KM_JOYSTICK MOVEABLE DISCARDABLE
BEGIN
    DIALOG "", DLG_KM_JOYSTICK, 0, 0, 200, 150, WS_VISIBLE
    BEGIN
        AUTOCHECKBOX "", IDC_KM_JOY_EN, 4, 134, 12, 12, WS_GROUP
        CONTROL "", IDC_KM_JEN_L, 18, 136, 176, 10, "MMUniText", WS_VISIBLE
        AUTORADIOBUTTON "", IDC_KM_JOY_A, 16, 120, 12, 11, WS_GROUP
        CONTROL "", IDC_KM_JA_L, 30, 121, 56, 10, "MMUniText", WS_VISIBLE
        AUTORADIOBUTTON "", IDC_KM_JOY_B, 94, 120, 12, 11
        CONTROL "", IDC_KM_JB_L, 108, 121, 56, 10, "MMUniText", WS_VISIBLE
        CONTROL "", IDC_KM_JH1, 4, 104, 192, 10, "MMUniText", WS_VISIBLE
        CONTROL "", IDC_KM_JH2, 4, 92, 192, 10, "MMUniText", WS_VISIBLE
        CONTROL "", IDC_KM_JL1+0, 4, 72, 82, 10, "MMUniText", WS_VISIBLE
        ENTRYFIELD "", IDC_KM_JBTN1+0, 90, 70, 100, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP | WS_GROUP
        CONTROL "", IDC_KM_JL1+1, 4, 56, 82, 10, "MMUniText", WS_VISIBLE
        ENTRYFIELD "", IDC_KM_JBTN1+1, 90, 54, 100, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        CONTROL "", IDC_KM_JL1+2, 4, 40, 82, 10, "MMUniText", WS_VISIBLE
        ENTRYFIELD "", IDC_KM_JBTN1+2, 90, 38, 100, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        CONTROL "", IDC_KM_JL1+3, 4, 24, 82, 10, "MMUniText", WS_VISIBLE
        ENTRYFIELD "", IDC_KM_JBTN1+3, 90, 22, 100, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        CONTROL "", IDC_KM_CAL,   4, 2, 94, 14, WC_BUTTON, BS_USERBUTTON | WS_TABSTOP | WS_GROUP | WS_VISIBLE
        CONTROL "", IDC_KM_CALB, 102, 2, 94, 14, WC_BUTTON, BS_USERBUTTON | WS_TABSTOP | WS_VISIBLE
    END
END
